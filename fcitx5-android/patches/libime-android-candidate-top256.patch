+        auto candidateBegin = d->candidates_.begin() + beginSize;
+#if defined(__ANDROID__)
+        // Android initially renders only 16 candidates and requests additional
+        // pages on demand. Short prefixes (for example "z") can otherwise
+        // produce thousands of single-pinyin candidates that are fully sorted,
+        // deduplicated and wrapped on the latency-sensitive fcitx thread.
+        // Keep a generous ranked window for paging while avoiding that work.
+        constexpr size_t androidCandidateLimit = 256;
+        if (d->candidates_.size() - beginSize > androidCandidateLimit) {
+            auto candidateEnd = candidateBegin + androidCandidateLimit;
+            std::partial_sort(candidateBegin, candidateEnd,
+                              d->candidates_.end(), std::greater<>());
+            d->candidates_.erase(candidateEnd, d->candidates_.end());
+        } else {
+            std::sort(candidateBegin, d->candidates_.end(), std::greater<>());
+        }
+#else
+        std::sort(candidateBegin, d->candidates_.end(), std::greater<>());
+#endif
